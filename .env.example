# Copy to .env on the server (never commit .env). See DEPLOY.md.

# --- gateway ---
# published port binds here only — never 0.0.0.0
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8787
# JSON map product → sha256(key). Generate with: node gateway/scripts/gen-key.mjs <product>
PRODUCT_KEYS='{"mesgai":"<sha256-hex>","tokofy":"<sha256-hex>"}'
# Addresses allowed to call the gateway (IPs or CIDRs).
#  127.0.0.1      = inside the container (healthcheck)
#  172.31.87.1    = the host itself (nginx / cloudflared / curl on the server) — see AI_EDGE_SUBNET
#  <WINDOWS_VPS_IP> = the Koneqti brain/worker server (arrives via nginx X-Forwarded-For)
ALLOWED_IPS=127.0.0.1,172.31.87.1
# Proxies whose X-Forwarded-For header is trusted (the host, via the docker bridge)
TRUST_PROXY=127.0.0.1,172.31.87.1
# batch window, server local time (TZ below)
OFFPEAK_WINDOW=01:00-07:00
TZ=Asia/Karachi
MAX_CONTEXT_TOKENS=4096
LOG_LEVEL=info
USAGE_RETENTION_DAYS=180
# Stage 2 only
VOICE_CLONE_ENABLED=false

# --- ollama ---
OLLAMA_NUM_PARALLEL=2
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MODEL=qwen3:4b
# Pin after first deploy, e.g. ollama/ollama:0.x.y (check `docker exec ai-gateway-ollama-1 ollama -v`)
OLLAMA_IMAGE=ollama/ollama:latest

# --- network ---
# change only if it clashes with an existing docker network
AI_EDGE_SUBNET=172.31.87.0/24
SERVICE_LOG_LEVEL=INFO
