{
  "name": "koneqti-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Private, local-only AI gateway for Koneqti products (Stage 0)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "gen-key": "node scripts/gen-key.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "ipaddr.js": "^2.5.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
